@page
@model IndexModel
@{
    ViewData["Title"] = "Teleprompter me inteligjencë artificiale";
}

@* Signed-in users are sent to the studio by IndexModel.OnGet; this page is the public front door. *@
<section class="home">
    <div class="home-intro">
        <p class="home-eyebrow">SyriAI Studio</p>
        <h1>Teleprompteri që ndjek zërin tuaj.</h1>
        <p class="home-lead">
            Shkruani ose ngarkoni lajmet, shtypni “Fillo LIVE” dhe teksti lëviz vetë ndërsa flisni,
            me ekran për prezantuesin dhe dalje direkte për YouTube.
        </p>
        <ul class="home-points">
            <li><strong>Ndjekje me zë</strong><span>Teksti ndalet kur ndaleni, vazhdon kur vazhdoni.</span></li>
            <li><strong>Rendi i lajmeve</strong><span>Koha për çdo lajm dhe mesazhe nga regjia.</span></li>
            <li><strong>Grafika në ekran</strong><span>Tituj, baner me emrin dhe efekte kamere.</span></li>
        </ul>
    </div>

    <div class="home-card">
        <h2>Hyr në studio</h2>
        <form method="post" action="/Identity/Account/Login" data-busy="Duke hyrë…">
            @Html.AntiForgeryToken()
            <label for="loginEmail">Email</label>
            <input type="email" name="Input.Email" id="loginEmail" placeholder="email@shembull.com" autocomplete="username" required>

            <div class="home-row">
                <label for="loginPass">Fjalëkalimi</label>
                <a asp-area="Identity" asp-page="/Account/ForgotPassword">Keni harruar?</a>
            </div>
            <input type="password" name="Input.Password" id="loginPass" placeholder="••••••••" autocomplete="current-password" required>

            <button type="submit" class="home-btn">Hyr</button>
        </form>
        <p class="home-alt">
            Nuk keni llogari? <a asp-area="Identity" asp-page="/Account/Register">Krijo një llogari</a>
        </p>
    </div>
</section>
