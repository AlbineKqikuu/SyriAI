@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<nav class="site-nav">
@if (SignInManager.IsSignedIn(User))
{
    <a href="/studio/AdminPage.html">Studio</a>
    <span class="site-user">@(User.FindFirst("display_name")?.Value ?? User.Identity?.Name)</span>
    <a href="/logout">Dil</a>
}
else
{
    <a asp-area="Identity" asp-page="/Account/Register">Regjistrohu</a>
    <a class="site-nav-cta" asp-area="Identity" asp-page="/Account/Login">Kyçu</a>
}
</nav>
