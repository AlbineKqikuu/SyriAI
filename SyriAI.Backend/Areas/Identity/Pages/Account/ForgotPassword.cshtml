@page
@model SyriAI.Backend.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Keni harruar fjalëkalimin";
    ViewData["Subtitle"] = "Shkruani email-in e llogarisë. Do t'ju dërgojmë një kod për të vendosur fjalëkalim të ri.";
    Layout = "_AuthLayout";
}

<form method="post">
    <div asp-validation-summary="All" class="validation-summary" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>
    <div class="form-group">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" placeholder="email@shembull.com" autocomplete="username" autofocus />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <button type="submit">Dërgo kodin</button>
</form>

<div class="footer-links">
    <a asp-page="./Login">Kthehu te kyçja</a>
</div>
