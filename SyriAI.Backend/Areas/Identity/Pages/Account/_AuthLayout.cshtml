@* Shared shell for the account pages: login, register, e-mail verification, password reset *@
<!DOCTYPE html>
<html lang="sq">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SyriAI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
    <div class="background-blobs">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
    </div>

    <main class="auth-card">
        <div class="header">
            <div class="logo"><span class="logo-text">Syri<span>AI</span></span></div>
            <div class="subtitle">@ViewData["Subtitle"]</div>
        </div>

        @if (TempData["StatusMessage"] is string status)
        {
            <div class="alert alert-success" role="status">@status</div>
        }
        @if (TempData["WarningMessage"] is string warning)
        {
            <div class="alert alert-warning" role="alert">@warning</div>
        }

        @RenderBody()
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
