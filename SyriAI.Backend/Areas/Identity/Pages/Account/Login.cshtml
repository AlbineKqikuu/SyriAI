@page
@model SyriAI.Backend.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Kyçu";
    ViewData["Subtitle"] = "Qendra e kontrollit të transmetimit";
    Layout = "_AuthLayout";
}

<form id="account" method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="All" class="validation-summary" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <div class="form-group">
        <label asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" type="email" placeholder="email@shembull.com" autocomplete="username" aria-required="true" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <div class="row-between">
            <label asp-for="Input.Password">Fjalëkalimi</label>
            <a asp-page="./ForgotPassword" class="small-link">Keni harruar fjalëkalimin?</a>
        </div>
        <input asp-for="Input.Password" type="password" placeholder="••••••••" autocomplete="current-password" aria-required="true" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="checkbox-group">
        <input asp-for="Input.RememberMe" />
        <label asp-for="Input.RememberMe">Më mbaj të kyçur</label>
    </div>

    <button type="submit">Hyr në studio</button>
</form>

<div class="footer-links">
    Nuk keni llogari? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Regjistrohu këtu</a>
</div>
