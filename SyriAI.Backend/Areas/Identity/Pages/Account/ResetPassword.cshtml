@page
@model SyriAI.Backend.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Fjalëkalim i ri";
    ViewData["Subtitle"] = Html.Raw($"Shkruani kodin që dërguam në <strong>{System.Net.WebUtility.HtmlEncode(Model.Input.Email)}</strong> dhe fjalëkalimin e ri");
    Layout = "_AuthLayout";
}

@if (!Model.CanSendEmail)
{
    <div class="alert alert-info">Mënyra e zhvillimit: dërgimi i email-it nuk është konfiguruar, prandaj kodi shfaqet në terminalin ku po punon serveri.</div>
}

<form method="post">
    <div asp-validation-summary="All" class="validation-summary" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>
    <input type="hidden" asp-for="Input.Email" />

    <div class="form-group">
        <label asp-for="Input.Code">Kodi</label>
        <input asp-for="Input.Code" class="code-input" inputmode="numeric" autocomplete="one-time-code"
               maxlength="6" placeholder="••••••" autofocus />
        <p class="hint">Kodi vlen për @Model.ValidMinutes minuta.</p>
        <span asp-validation-for="Input.Code" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.Password">Fjalëkalimi i ri</label>
        <input asp-for="Input.Password" type="password" placeholder="••••••••" autocomplete="new-password" />
        <p class="hint">Të paktën 8 karaktere.</p>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.ConfirmPassword">Konfirmo fjalëkalimin</label>
        <input asp-for="Input.ConfirmPassword" type="password" placeholder="••••••••" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit">Ruaj fjalëkalimin</button>
</form>

<div class="footer-links">
    <a asp-page="./ForgotPassword">Kërko një kod të ri</a> · <a asp-page="./Login">Kthehu te kyçja</a>
</div>

@section Scripts {
    <script>
        const code = document.getElementById('Input_Code');
        code.addEventListener('input', () => { code.value = code.value.replace(/\D/g, '').slice(0, 6); });
    </script>
}
