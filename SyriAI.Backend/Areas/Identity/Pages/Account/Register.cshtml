@page
@model SyriAI.Backend.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Regjistrohu";
    ViewData["Subtitle"] = "Krijo llogari të re";
    Layout = "_AuthLayout";
}

<form asp-route-returnUrl="@Model.ReturnUrl" method="post">
    <div asp-validation-summary="All" class="validation-summary" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <div class="form-group">
        <label asp-for="Input.Email">Email</label>
        <input asp-for="Input.Email" type="email" placeholder="email@shembull.com" autocomplete="username" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.Password">Fjalëkalimi</label>
        <input asp-for="Input.Password" type="password" placeholder="••••••••" autocomplete="new-password" />
        <p class="hint">Të paktën 8 karaktere.</p>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.ConfirmPassword">Konfirmo fjalëkalimin</label>
        <input asp-for="Input.ConfirmPassword" type="password" placeholder="••••••••" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>

    <button type="submit">Regjistrohu</button>
    <p class="hint" style="text-align:center;margin-top:0.9rem;">Do t'ju dërgojmë një kod me 6 shifra për të verifikuar email-in.</p>
</form>

<div class="footer-links">
    Keni një llogari? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Kyçu këtu</a>
</div>
